# Binaries
/websearch
*.exe
bin/

# Secrets & local environment
.env
cookies*.json
# A live session export must never be committable, whatever it is named.
cookie*
*_cookies.json
storage_state*.json

# Go tooling
coverage.out
*.test

# OS noise
.DS_Store
Thumbs.db

# Python tooling (the deck generator and the ReAct replica)
__pycache__/
*.pyc

# Local scratch helpers (throwaway tooling, never part of the service)
tmp_*/eval/
# Runtime output dirs: exports and eval scorecards land here on every local
# run. They are machine-local; the scorecards cited by docs stay tracked.
/artifacts/
/eval/
# Dead local binary snapshots
server.exe~
