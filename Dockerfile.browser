# Browser-enabled image for ENABLE_BROWSER_FALLBACK=true.
FROM golang:1.24-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" -o websearch ./cmd/server
# The playwright-go CLI (pure Go) downloads and drives the Node runtime the
# binding needs; it is installed here and shipped, because the Alpine builder
# cannot run the glibc Node binary the driver downloads.
RUN go install github.com/mxschmitt/playwright-go/cmd/playwright@v0.6201.1

# Keep this version aligned with github.com/mxschmitt/playwright-go v0.6201.1.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /app
COPY --from=builder /app/websearch /app/websearch
COPY --from=builder /go/bin/playwright /app/playwright
# The binding needs its Node driver on disk — the base image ships Chromium and
# the browsers but not the Go binding's driver. Download it here (glibc userland
# and the base image's Node make the driver work) and point the binding at the
# shipped copy: the driver's default directory is $HOME/.cache, which the
# non-root runtime user does not share.
RUN /app/playwright --version \
    && mkdir -p /app/ms-playwright-go \
    && mv /root/.cache/ms-playwright-go/1.62.1 /app/ms-playwright-go/1.62.1
ENV PLAYWRIGHT_DRIVER_PATH=/app/ms-playwright-go/1.62.1
RUN useradd --create-home --shell /bin/bash appuser && chown -R appuser:appuser /app

EXPOSE 8080
ENV PORT=8080
USER appuser

ENTRYPOINT ["/app/websearch"]