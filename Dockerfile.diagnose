# Diagnostic image for the weedoo.in access matrix: the SAME Playwright image
# the production service runs (matching browser build), with the probe script
# baked in. Run as a Cloud Run Job in asia-south1 to reproduce the production
# egress environment.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /app
COPY scripts/weedoo-diagnose.js /app/weedoo-diagnose.js
# The base image's browsers live in /ms-playwright (PLAYWRIGHT_BROWSERS_PATH);
# only the JS library needs installing, scripts skipped so no browser download.
RUN npm install --no-save --ignore-scripts playwright@1.62.1
ENTRYPOINT ["node", "/app/weedoo-diagnose.js"]